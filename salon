### client/src/components/BookingForm.jsx
```jsx
import React, {useState, useEffect} from 'react'
import axios from 'axios'

export default function BookingForm(){
  const [services, setServices] = useState([])
  const [form, setForm] = useState({service_id:'', user_email:'', date:'', time:'', notes:''})

  useEffect(()=>{ axios.get('/api/services').then(r=>setServices(r.data)) }, [])

  const submit = async (e)=>{
    e.preventDefault();
    if(!form.service_id || !form.user_email || !form.date || !form.time) return alert('fill fields')
    const start = new Date(`${form.date}T${form.time}:00`)
    const service = services.find(s=>s.id==form.service_id)
    const end = new Date(start.getTime() + service.duration_minutes*60000)
    try{
      const resp = await axios.post('/api/bookings', {
        service_id: form.service_id,
        user_email: form.user_email,
        start_iso: start.toISOString(),
        end_iso: end.toISOString(),
        notes: form.notes
      })
      alert('Booked!')
    }catch(err){
      alert(err.response?.data?.error || 'Error')
    }
  }

  return (
    <form onSubmit={submit} className="bg-white p-6 rounded shadow max-w-md">
      <label className="block mb-2">Email
        <input className="w-full p-2 border mt-1" value={form.user_email} onChange={e=>setForm({...form,user_email:e.target.value})} />
      </label>
      <label className="block mb-2">Service
        <select className="w-full p-2 border mt-1" value={form.service_id} onChange={e=>setForm({...form,service_id:e.target.value})}>
          <option value="">Choose</option>
          {services.map(s=> <option value={s.id} key={s.id}>{s.name} ({s.duration_minutes}m)</option>)}
        </select>
      </label>
      <div className="flex gap-2">
        <label className="flex-1">Date
          <input type="date" className="w-full p-2 border mt-1" onChange={e=>setForm({...form,date:e.target.value})} />
        </label>
        <label className="flex-1">Time
          <input type="time" className="w-full p-2 border mt-1" onChange={e=>setForm({...form,time:e.target.value})} />
        </label>
      </div>
      <label className="block mt-3">Notes
        <textarea className="w-full p-2 border mt-1" onChange={e=>setForm({...form,notes:e.target.value})} />
      </label>
      <button className="mt-4 bg-blue-600 text-white px-4 py-2 rounded">Book appointment</button>
    </form>
  )
}
