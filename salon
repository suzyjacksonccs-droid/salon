### server/routes/bookings.js
```js
const express = require('express');
const router = express.Router();
const db = require('../db');

// List bookings
router.get('/', (req, res) => {
  db.all('SELECT b.*, s.name as service_name FROM bookings b LEFT JOIN services s ON s.id=b.service_id ORDER BY start_iso', [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows);
  });
});

// Create booking with simple overlap prevention
router.post('/', (req, res) => {
  const { service_id, user_email, start_iso, end_iso, notes } = req.body;
  // check overlap
  db.get(
    `SELECT COUNT(*) as cnt FROM bookings WHERE status='booked' AND (
      (start_iso <= ? AND end_iso > ?) OR
      (start_iso < ? AND end_iso >= ?)
    )`,
    [start_iso, start_iso, end_iso, end_iso],
    (err, row) => {
      if (err) return res.status(500).json({ error: err.message });
      if (row.cnt > 0) return res.status(409).json({ error: 'Time slot not available' });

      db.run('INSERT INTO bookings (service_id, user_email, start_iso, end_iso, notes) VALUES (?,?,?,?,?)',
        [service_id, user_email, start_iso, end_iso, notes], function(err) {
          if (err) return res.status(500).json({ error: err.message });
          db.get('SELECT * FROM bookings WHERE id = ?', [this.lastID], (e, b) => res.json(b));
        }
      );
    }
  );
});

module.exports = router;
```

